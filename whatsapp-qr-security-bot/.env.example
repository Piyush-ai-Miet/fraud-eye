# Fraud Eye - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# ADMIN CREDENTIALS (REQUIRED)
# ============================================
# Set these on your deployment platform (Render/Heroku)
# DO NOT commit actual values to GitHub

ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_hashed_password_here

# Generate password hash:
# python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"

# ============================================
# FACE RECOGNITION (REQUIRED FOR ADMIN)
# ============================================
# Face data is stored server-side only
# Upload face images after deployment via /admin/register

FACE_AUTH_ENABLED=true
FACE_MATCH_THRESHOLD=0.45

# ============================================
# API KEYS (OPTIONAL - For Enhanced Detection)
# ============================================

# VirusTotal API (Primary URL checker)
# Get free key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# URLScan.io API (Fallback URL checker)
# Get free key: https://urlscan.io/user/signup
URLSCAN_API_KEY=your_urlscan_api_key_here

# Dangerous Domains API (Fallback)
# Free tier available
DANGEROUS_DOMAINS_API_KEY=your_dangerous_domains_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

FLASK_ENV=production
FLASK_DEBUG=false
PORT=5001

# Session Security
SECRET_KEY=generate_random_secret_key_here
SESSION_TIMEOUT=86400

# ============================================
# SECURITY NOTES
# ============================================
# 1. Never commit .env file to GitHub
# 2. Use strong passwords (min 12 characters)
# 3. Rotate API keys regularly
# 4. Enable 2FA on all API accounts
# 5. Monitor unauthorized access logs
